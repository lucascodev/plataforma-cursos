{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,60}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "tagline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "level": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "rhythm": {
      "type": "object",
      "properties": {
        "weekdayHours": {
          "type": "number",
          "minimum": 0,
          "maximum": 8
        },
        "saturdayHours": {
          "type": "number",
          "minimum": 0,
          "maximum": 12
        },
        "sundayHours": {
          "type": "number",
          "minimum": 0,
          "maximum": 12
        }
      },
      "required": [
        "weekdayHours",
        "saturdayHours",
        "sundayHours"
      ],
      "additionalProperties": false
    },
    "kickoff": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        }
      },
      "required": [
        "title",
        "detail"
      ],
      "additionalProperties": false
    },
    "sundayTrack": {
      "type": "object",
      "properties": {
        "moduleId": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,60}$"
        },
        "rotation": {
          "minItems": 1,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "detail": {
                "type": "string",
                "minLength": 1,
                "maxLength": 800
              }
            },
            "required": [
              "title",
              "detail"
            ],
            "additionalProperties": false
          }
        },
        "milestones": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "detail": {
                "type": "string",
                "minLength": 1,
                "maxLength": 800
              },
              "sunday": {
                "type": "integer",
                "minimum": -60,
                "maximum": 260
              },
              "lessonIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "title",
              "detail",
              "sunday"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "moduleId",
        "rotation",
        "milestones"
      ],
      "additionalProperties": false
    },
    "modules": {
      "minItems": 1,
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,60}$"
          },
          "shortTitle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "kind": {
            "type": "string",
            "enum": [
              "standard",
              "capstone",
              "continuous"
            ]
          },
          "months": {
            "type": "number",
            "minimum": 0,
            "maximum": 24
          },
          "projectDays": {
            "type": "integer",
            "minimum": 4,
            "maximum": 60
          },
          "prerequisite": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "caseStudy": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "lowSpecTip": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          },
          "lessons": {
            "minItems": 1,
            "maxItems": 40,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 600
                },
                "exercise": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 800
                }
              },
              "required": [
                "title",
                "summary",
                "exercise"
              ],
              "additionalProperties": false
            }
          },
          "drills": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "task": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 800
                }
              },
              "required": [
                "title",
                "task"
              ],
              "additionalProperties": false
            }
          },
          "project": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "brief": {
                "type": "string",
                "minLength": 1,
                "maxLength": 800
              },
              "requirements": {
                "minItems": 1,
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                }
              },
              "doneCriteria": {
                "minItems": 1,
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                }
              }
            },
            "required": [
              "title",
              "brief",
              "requirements",
              "doneCriteria"
            ],
            "additionalProperties": false
          },
          "selfCheck": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "resources": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "type",
                "label",
                "url"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "shortTitle",
          "title",
          "kind",
          "months",
          "prerequisite",
          "goal",
          "caseStudy",
          "lessons",
          "drills",
          "project",
          "selfCheck",
          "resources"
        ],
        "additionalProperties": false
      }
    },
    "guide": {
      "type": "object",
      "properties": {
        "architecture": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 800
            },
            "rows": {
              "minItems": 1,
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "nodes": {
                    "minItems": 1,
                    "maxItems": 6,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "title": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        },
                        "detail": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "highlight": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "title",
                        "detail"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "nodes"
                ],
                "additionalProperties": false
              }
            },
            "bands": {
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "tone": {
                    "type": "string",
                    "enum": [
                      "accent",
                      "warning"
                    ]
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                },
                "required": [
                  "tone",
                  "text"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "title",
            "description",
            "rows",
            "bands"
          ],
          "additionalProperties": false
        },
        "sections": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "intro": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "items": {
                "minItems": 1,
                "maxItems": 15,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "link": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "label",
                  "url"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "title",
              "items"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "sections"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "slug",
    "title",
    "tagline",
    "description",
    "level",
    "audience",
    "version",
    "updatedAt",
    "rhythm",
    "kickoff",
    "modules"
  ],
  "additionalProperties": false,
  "$id": "course.schema.json",
  "title": "Curso da plataforma Cursos Abertos"
}
