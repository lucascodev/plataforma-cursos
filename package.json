{
  "name": "plataforma-cursos",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "description": "Plataforma aberta de cursos com plano diário, projetos práticos e progresso por usuário.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:site": "vite",
    "dev:api": "wrangler pages dev public --port 8788 --compatibility-date 2026-10-01",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/check-build-secrets.mjs dist",
    "preview": "pnpm build && wrangler pages dev dist --port 8788 --compatibility-date 2026-10-01",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "node scripts/generate-seed-sql.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:new": "supabase migration new",
    "db:status": "supabase migration list --linked",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --level error",
    "db:push": "supabase db push --linked",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "audit:prod": "pnpm audit --prod --audit-level high"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tanstack/react-query": "^5.105.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "pyodide": "314.0.7",
    "sql.js": "1.14.2",
    "supabase": "2.122.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lucascodev/plataforma-cursos.git"
  }
}
