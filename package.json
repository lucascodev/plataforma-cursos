{
  "name": "plataforma-cursos",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "description": "Plataforma aberta de cursos com plano diário, projetos práticos e progresso por usuário.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:site": "vite",
    "dev:api": "wrangler pages dev public --port 8788 --compatibility-date 2026-10-01",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/check-build-secrets.mjs dist",
    "preview": "pnpm build && wrangler pages dev dist --port 8788 --compatibility-date 2026-10-01",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:schema": "node scripts/generate-course-schema.ts",
    "content:import": "node --env-file=.env.local scripts/import-course.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:new": "supabase migration new",
    "db:status": "supabase migration list --linked",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --level error",
    "db:push": "supabase db push --linked",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "audit:prod": "pnpm audit --prod --audit-level high"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@tanstack/react-query": "^5.80.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "supabase": "2.122.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.40.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SEU-USUARIO/plataforma-cursos.git"
  }
}
